SELECT	$project
GROUP BY	$group
ORDER BY	$sort
LIMIT	$limit
OFFSET	$skip
JOIN	$lookup
COUNT()	$count / $sum
AVG()	$avg
SUM()	$sum
MIN()	$min
MAX()	$max
    {
        $match: {
            category: "Electronics"
        }
    },
    {
        $sort: {
            price: -1
        }
